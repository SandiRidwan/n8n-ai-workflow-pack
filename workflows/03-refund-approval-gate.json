  "pinData": {},
  "meta": {
    "description": "A refund workflow that FAILS CLOSED. Requests above AUTO_APPROVE_MAX are parked for a human (Slack approve/reject buttons) and are never refunded automatically. The approval rule is an explicit, auditable policy, and every request produces an audit record.",
    "requires": [
